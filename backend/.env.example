# DeepSeek API Configuration (optional — leave the key empty for offline mode)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Privacy / retention (keep true: nothing is written to disk)
ZERO_RETENTION_MODE=true

# Data Directories
DATA_DIR=../data
SAMPLE_DATA_PATH=../data/sample/demo_associations.json
